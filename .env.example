# Copie para .env e ajuste. Nunca faça commit do .env.
DATABASE_URL="postgresql://milheiro:milheiro_dev@127.0.0.1:5444/milheiro?schema=public"
# Banco usado pelos testes automatizados (é limpo a cada execução)
# Testes E2E (Playwright): banco próprio; sem esta linha usa o TEST_DATABASE_URL trocando _test por _e2e.
# O E2E se recusa a rodar num banco sem "e2e" no nome.
# E2E_DATABASE_URL="postgresql://milheiro:milheiro_dev@127.0.0.1:5444/milheiro_e2e?schema=public"
TEST_DATABASE_URL="postgresql://milheiro:milheiro_dev@127.0.0.1:5444/milheiro_test?schema=public"
# Redis do Chat Balcões em tempo real (em produção o docker-compose.prod.yml aponta para o contêiner redis)
REDIS_URL="redis://127.0.0.1:6380"
# Chat Balcões em tempo real (eventos do Telegram pelo WebSocket). Desligado até a etapa do listener ser validada.
REALTIME_ENABLED="false"
# Nome exibido na interface
APP_NAME="MilhasX"
# URL pública da aplicação (usada em links de redefinição de senha e na checagem de origem)
APP_URL="http://localhost:3100"

# Chave para criptografar credenciais das contas (32 bytes em base64). Gere com:
# node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
# Sem ela, a seção "Credenciais de acesso" fica desativada.
CREDENTIALS_KEY=""

# Telegram (Configurações › Telegram e Chat Balcões), opcional. Gere em my.telegram.org › API development tools
# (plataforma Bot / Server). As sessões das contas ficam no banco, criptografadas com a CREDENTIALS_KEY.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Balcão MilhasX (ofertas do balcão e propostas), opcional. A API de parceiro do Balcão (projeto balcaogomilhasx-app),
# só pela rede interna do Docker. O segredo é o PARTNER_API_SECRET do .env do Balcão. Os tokens dos vínculos ficam
# criptografados com a CREDENTIALS_KEY. Vazio = a página Balcão MilhasX avisa que está desligada.
BALCAO_API_URL=""
BALCAO_API_SECRET=""

# Assistente IA (opcional). Sem a chave, o botão "IA" mostra que o assistente não está configurado.
ANTHROPIC_API_KEY=""
# Modelo usado pelo assistente (padrão: claude-opus-5-5)
AI_MODEL=""

# Pagamento das assinaturas pelo Mercado Pago (opcional). Sem o token, a troca de plano vira um
# pedido que o admin ativa em Administração › Usuários.
# Token: Suas integrações › Credenciais (use as de TESTE até validar o fluxo).
MP_ACCESS_TOKEN=""
# Assinatura secreta dos webhooks: Suas integrações › Webhooks. Cadastre a URL
# <APP_URL>/api/billing/webhook com o evento "Planos e assinaturas" (subscription_preapproval).
MP_WEBHOOK_SECRET=""


# Marca da página pública das agências ("Sua MilhasX" no menu, cabeçalho da Central de Atendimento)
PUBLIC_BRAND="MilhasX"

# Entrar/Cadastrar com Google (opcional; sem as duas chaves o botão não aparece).
# Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth (Aplicativo da Web).
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile no cadastro (opcional; sem as chaves a verificação fica desligada).
# Cloudflare › Turnstile › Add widget, com o domínio do app.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# E-mail de contato exibido nos Termos de Serviço e na Política de Privacidade (opcional)
CONTACT_EMAIL=""

# Envio de e-mail (redefinição de senha, convites da equipe, acesso do titular). Sem SMTP_HOST/USER/PASS
# as mensagens ficam na pasta .outbox do servidor. Hostinger: smtp.hostinger.com, porta 465 (SSL),
# usuário = endereço completo da caixa e a senha dela. MAIL_FROM tem que ser a caixa ou um alias dela.
# Teste: npm run mail:test -- seu@email.com
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Push no celular (Web Push): gere com `npm run push:keys` e cole aqui.
# Trocar as chaves desliga o push de todos os aparelhos (cada um ativa de novo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
