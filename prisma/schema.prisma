// Valores financeiros sempre em centavos (Int). Pontos em Int.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ProgramKind {
  POINTS
  MILES
}

enum EntryType {
  INITIAL_BALANCE // Saldo inicial (sem custo)
  PURCHASE // Compra de pontos (com custo)
  CLUB // Pontos de clube (com custo da mensalidade)
  CARD // Pontos de cartão (sem custo)
  PARTNER_PURCHASE // Compra em parceiro
  FLIGHT // Pontos de voo
  HOTEL // Pontos de hotel
  BONUS // Bônus de pontos
  OTHER_CREDIT // Outros créditos (custo opcional)
  TRANSFER_IN // Entrada de transferência (custo vem da origem)
  TRANSFER_BONUS // Bônus de transferência (divide o custo da transferência)
  TRANSFER_OUT // Saída de transferência
  SALE // Venda de pontos (débito)
  SALE_REFUND // Reembolso de venda: as milhas voltam com o custo com que saíram
  FLIGHT_REDEMPTION // Emissão de passagem
  CAR_RENTAL // Aluguel de veículo
  HOTEL_REDEMPTION // Reserva de hotel
  PRODUCT_REDEMPTION // Resgate de produto
  EXPIRATION // Expiração (débito)
  OTHER_DEBIT // Outros débitos / ajuste
}

enum EntryStatus {
  CONFIRMED
  PENDING // pontos a receber: não entram no saldo
}

enum AlertType {
  MIN_BALANCE // saldo da conta < limite
}

enum InvoiceStatus {
  OPEN
  CLOSED
}

enum GuideKind {
  VIDEO
  ARTICLE
}

enum GuideLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions         Session[]
  resetTokens      PasswordResetToken[]
  holders          Holder[]
  accounts         Account[]
  entries          Entry[]
  customers        Customer[]
  sales            Sale[]
  alerts           Alert[]
  notifications    Notification[]
  preference       UserPreference?
  auditLogs        AuditLog[]
  suppliers        Supplier[]
  supplierAccounts SupplierAccount[]
  cards            CreditCard[]

  recurrences     Recurrence[]
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  simulations     Simulation[]
  showcaseItems   ShowcaseItem[]
  agencySite      AgencySite?
  siteImages      SiteImage[]

  // Assinatura: o plano só muda pela administração (sem cobrança real)
  plan                Plan                @default(PESSOAL)
  planInterval        String?
  trialEndsAt         DateTime?
  planRequest         Plan?
  planRequestInterval String?
  planRequestedAt     DateTime?
  deletionRequestedAt DateTime?
  referralCode        String?             @unique
  referredById        String?
  referredBy          User?               @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]              @relation("Referrals")
  salesProfile        SalesProfile?
  subscriptions       Subscription[]
  travelOrders        TravelOrder[]
  orderPipelines      OrderPipeline[]
  viajeFacil          ViajeFacil[]
  finAccounts         FinAccount[]
  finTransactions     FinTransaction[]
  cardBillPayments    CardBillPayment[]
  cardBills           CardBill[]
  teamMembers         TeamMember[]
  taskBoards          TaskBoard[]
  partners            Partner[]
  tasks               Task[]
  goals               Goal[]
  processes           Process[]
  passengers          Passenger[]
  travelInterests     TravelInterest[]
  milesDeals          MilesDeal[]
  flightQuotes        FlightQuote[]
  flightSearches      FlightSearch[]
  milesLeads          MilesLead[]
  contractSignatures  ContractSignature[]
  telegramLinks       TelegramLink[]
  telegramAlerts      TelegramAlert[]
}

/// Conta do Telegram do usuário (pode ter várias), conectada para ler o grupo do balcão (só leitura). A sessão dá
/// acesso à conta: fica criptografada (CREDENTIALS_KEY). O login é em etapas: código enviado → (senha de duas
/// etapas) → ativa. Um número por usuário.
model TelegramLink {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionEnc    String // sessão do Telegram, criptografada
  status        String   @default("CODE_SENT") // CODE_SENT | PASSWORD_NEEDED | ACTIVE
  phone         String // número usado no login (+55...)
  phoneCodeHash String? // da etapa do código (sai quando o login termina)
  codeViaApp    Boolean  @default(true) // o código chegou no app do Telegram (senão, por SMS)
  accountName   String? // conta conectada (nome e @usuário)
  groupId       String? // grupo do balcão escolhido
  groupTitle    String?
  groupPeer     Json? // como chegar no grupo sem listar os chats: { kind: "channel", id, hash } ou { kind: "chat", id }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
}

/// Alerta do Chat Balcões: destaca e avisa quando uma mensagem dos grupos tem todas as palavras dele.
model TelegramAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  words     String[] // todas precisam aparecer na mensagem (sem diferenciar maiúsculas e acentos)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Plan {
  PESSOAL
  PRO
  GESTOR
}

model SalesProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String    @unique
  displayName     String
  bio             String?
  whatsapp        String?
  instagram       String?
  email           String?
  programIds      String[]
  published       Boolean   @default(false)
  acceptsOrders   Boolean   @default(true) // formulário "Pedir cotação" na página pública
  acceptsLeads    Boolean   @default(true) // formulário "Interesse em gestão de milhas"
  headline        String? // frase de abertura da Central de Atendimento
  views           Int       @default(0)
  design          Json? // personalização da página (domain/page-design.ts)
  banner          Bytes?
  bannerMime      String?
  bannerUpdatedAt DateTime?
  showcaseActive  Boolean   @default(false) // vitrine pública de pacotes (/p/<slug>/vitrine)
  showcaseTitle   String?
  updatedAt       DateTime  @updatedAt
}

// Site da agência (Marketing › Site): tema escolhido e conteúdo das páginas (domain/site.ts)
model AgencySite {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("atlantico")
  published Boolean  @default(false)
  content   Json
  updatedAt DateTime @updatedAt
}

// Fotos enviadas para o site (capa, textos, galeria e logo)
model SiteImage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

model ShowcaseItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String? // cotação do CRM que originou o card (só referência)
  title          String
  destination    String
  period         String? // ex.: 16 a 23 de novembro
  includes       String[]  @default([]) // ex.: Aéreo ida e volta, Bagagem despachada
  description    String?
  priceCents     Int?
  priceNote      String? // ex.: por pessoa
  installments   String? // ex.: em até 10x sem juros
  image          Bytes?
  imageMime      String?
  imageUpdatedAt DateTime?
  active         Boolean   @default(true)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, position])
}

model Session {
  id        String   @id // sha256 do token; o token em si só existe no cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Program {
  id                  String      @id @default(cuid())
  name                String
  code                String      @unique
  kind                ProgramKind @default(POINTS)
  active              Boolean     @default(true)
  // Valor estimado de mercado por milheiro (centavos). Não é custo de aquisição.
  marketValueCpmCents Int         @default(0)
  color               String      @default("#3b82f6") // cor de identificação na interface
  logoUpdatedAt       DateTime? // versão da imagem (cache); os bytes ficam em ProgramLogo
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  accounts         Account[]
  logo             ProgramLogo?
  alerts           Alert[]
  supplierAccounts SupplierAccount[]
  partnersFrom     TransferPartner[] @relation("PartnerFrom")
  partnersTo       TransferPartner[] @relation("PartnerTo")
  clubPlans        ClubPlan[]
}

// Titular: pessoa dona de contas nos programas
model Holder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  isSelf       Boolean   @default(false) // "Minhas contas": o titular que é o próprio usuário
  active       Boolean   @default(true) // desativado some dos seletores, mas mantém o histórico
  birthDate    DateTime?
  documents    Json? // [{ type: CPF|CNPJ|RG|PASSAPORTE, number }]
  address      String?
  addressParts Json? // { cep, logradouro, numero, complemento, bairro, cidade, uf }
  accessEmail  String? // e-mail autorizado a ver a página do titular
  phone        String? // telefone/WhatsApp do titular (ex.: enviar o link da validação facial)
  attributes   Json? // [{ key, value }] (informações extras)
  notes        String?
  createdAt    DateTime  @default(now())

  accounts    Account[]
  attachments HolderAttachment[]
  accessLinks HolderAccess[]

  @@unique([userId, name])
}

// Carteira: um titular em um programa
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  holderId          String
  holder            Holder   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  programId         String
  program           Program  @relation(fields: [programId], references: [id])
  // Campos derivados do extrato (recalculados por replay)
  balance           Int      @default(0)
  costCents         Int      @default(0) // custo do saldo atual
  investedCents     Int      @default(0) // total investido em créditos com custo
  nickname          String? // nome da conta (em branco: programa + titular)
  pinned            Boolean  @default(false) // fixada na barra lateral
  archived          Boolean  @default(false)
  tags              String[] @default([])
  cpfAvailable      Int? // CPFs (passageiros) que ainda podem ser emitidos
  beneficiaryLimit  Int? // limite de beneficiários (CPFs distintos) do programa; vazio = sugestão do programa
  beneficiaryWindow String   @default("ROLLING_12M") // ROLLING_12M (últimos 12 meses) | CALENDAR_YEAR (ano civil)
  transferBonusPct  Int? // bônus que esta conta recebe em transferências enquanto o clube está ativo (ex.: 30)
  transferBonusCap  Int? // limite de milhas de bônus por mês (ex.: 30000 no Clube LATAM Pass); vazio = sem limite
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries       Entry[]
  sales         Sale[]
  milesDeals    MilesDeal[]
  alerts        Alert[]
  beneficiaries AccountBeneficiary[]
  cards         CreditCard[]
  recurrences   Recurrence[]
  credential    AccountCredential?

  @@unique([holderId, programId])
  @@index([userId])
}

model Entry {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type              EntryType
  status            EntryStatus @default(CONFIRMED)
  points            Int // positivo = crédito, negativo = débito
  inputCostCents    Int         @default(0) // custo informado pelo usuário (créditos com custo)
  costCents         Int         @default(0) // custo efetivo calculado pelo replay
  occurredAt        DateTime
  description       String
  reference         String?
  groupId           String? // agrupa as pernas de uma transferência ou venda
  details           Json? // detalhes do resgate: referência em dinheiro, passageiros, reserva, trecho, datas
  priorityPoints    Int? // transferência: pontos comprados no carrinho que saem primeiro
  priorityCostCents Int? // custo desses pontos comprados
  idempotencyKey    String?
  ignored           Boolean     @default(false) // fora dos relatórios (continua no saldo)
  createdAt         DateTime    @default(now())

  saleItem    SaleItem?
  invoice     CardInvoice?
  cardBalance CreditCard?  @relation("CardBalance")
  costs       EntryCost[]

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([groupId])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  kind      String   @default("FINAL") // FINAL (cliente final) | AGENCY (agência)
  docType   String? // CPF | CNPJ
  docNumber String?
  email     String?
  phone     String?
  documents Json? // documentos adicionais: [{ type, number }]
  createdAt DateTime @default(now())

  sales           Sale[]
  passengers      Passenger[]
  travelInterests TravelInterest[]
  saleItems       SaleItem[]       @relation("SaleItemCustomers")
  orders          TravelOrder[]
  milesDeals      MilesDeal[]

  @@index([userId])
}

// Venda de emissão (como na referência): origem dos pontos, itens, anexos.
// Custo dos pontos próprios vem do lançamento "Venda" de cada item (custo médio no momento);
// pontos de fornecedor custam o preço combinado da conta do fornecedor.
model Sale {
  id                     String           @id @default(cuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin                 String           @default("OWN") // OWN (meus pontos) | SUPPLIER (fornecedor)
  accountId              String?
  account                Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplierAccountId      String?
  supplierAccount        SupplierAccount? @relation(fields: [supplierAccountId], references: [id], onDelete: SetNull)
  customerId             String? // primeiro cliente (para listas)
  customer               Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  groupId                String?          @unique // agrupa os lançamentos "Venda" dos itens
  points                 Int // soma dos pontos dos itens
  totalCents             Int // total da venda: valor dos itens + custos repassados ao cliente
  occurredAt             DateTime
  refundedAt             DateTime? // reembolsada: milhas e taxas voltam; só a taxa de administração fica no faturamento
  refundFeeCents         Int              @default(0) // taxa de administração cobrada do cliente no reembolso
  refundMilesReceivedAt  DateTime? // estorno das milhas pela companhia (até lá ficam bloqueadas, a receber)
  refundTaxReceivedAt    DateTime? // estorno da taxa de embarque e dos repasses pela companhia
  paidAt                 DateTime? // cliente pagou (vazio = a receber)
  finAccountId           String? // conta do Financeiro em que o pagamento entrou (soma no saldo dela)
  finAccount             FinAccount?      @relation(fields: [finAccountId], references: [id], onDelete: SetNull)
  tags                 String[]         @default([]) // etiquetas livres para filtrar
  nfNumber               String? // nota fiscal de serviço emitida para a venda
  nfIssuedAt             DateTime?
  partnerId              String? // parceiro que trouxe a venda (comissão)
  partner                Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerCommissionCents Int              @default(0) // comissão calculada na venda (sai do lucro)
  issuerIds              String[]         @default([]) // quem emitiu (TeamMember); com mais de um, o resultado é rateado em partes iguais
  createdAt              DateTime         @default(now())

  items         SaleItem[]
  milesDeal     MilesDeal?
  attachments   SaleAttachment[]
  beneficiaries AccountBeneficiary[]

  @@index([userId, occurredAt])
}

model SaleItem {
  id               String     @id @default(cuid())
  saleId           String
  sale             Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind             String // FLIGHT | BAGGAGE | SEAT | HOTEL | CAR | OTHER
  issuedWith       String     @default("POINTS") // POINTS | CASH
  points           Int        @default(0)
  salePriceCents   Int // valor cobrado pelos pontos (ou pela emissão em dinheiro)
  cashCostCents    Int        @default(0) // emitido com dinheiro: quanto foi pago
  supplierCpmCents Int? // fornecedor: preço por milheiro no momento da venda
  costs            Json? // custos repassados: [{ type, amountCents, cardId }]
  clientType       String     @default("FINAL") // FINAL | AGENCY
  customers        Customer[] @relation("SaleItemCustomers")
  passengers       Int?
  reservation      String?
  origin           String?
  destination      String?
  departureDate    DateTime?
  returnDate       DateTime?
  description      String?
  observation      String?
  entryId          String?    @unique
  entry            Entry?     @relation(fields: [entryId], references: [id], onDelete: SetNull)
  position         Int        @default(0)

  @@index([saleId])
}

// Anexo da venda (comprovantes, contratos, cartões de embarque): até 10 arquivos, 10 MB no total
model SaleAttachment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([saleId])
}

model Alert {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            AlertType
  programId       String?
  program         Program?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threshold       Int // pontos
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  key       String? // aviso que só pode sair uma vez (ex.: bônus do mês); único por usuário
  clearedAt DateTime? // limpa da lista; a linha fica para o aviso com key não sair de novo

  @@unique([userId, key])
  @@index([userId, createdAt])
}

model UserPreference {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  showValues         Boolean   @default(true)
  checklistHidden    Boolean   @default(false)
  dashboardView      String    @default("gestao")
  newsReadAt         DateTime?
  soundEffects       Boolean   @default(true)
  usageAnalytics     Boolean   @default(true)
  hideVideoTutorials Boolean   @default(false)
  valuesMode         String    @default("VISIBLE")
  notifications      Json      @default("{}")
  pix                Json? // dados do PIX para cobrar o comprador: { keyType, key, name, bank }
  metricsHidden      String[]  @default([]) // blocos escondidos na página Métricas ("vendas.mix", ...)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Fornecedores: pessoas/empresas de quem você compra milhas ou cujas contas você administra.
// Nunca guardamos senhas de programas aqui.
model Supplier {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  notes     String?
  createdAt DateTime @default(now())

  accounts SupplierAccount[]

  @@index([userId])
}

model SupplierAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  identifier    String? // ex.: número de fidelidade ou apelido (não é senha)
  balance       Int      @default(0)
  priceCpmCents Int      @default(0) // preço combinado por milheiro
  cpfAvailable  Int? // CPFs (passageiros) que ainda podem ser emitidos nessa conta
  tags          String[] @default([])
  notes         String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  sales         Sale[]

  @@index([userId])
}

model CreditCard {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String // conta (titular × programa) que recebe os pontos
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  brand           String? // Visa, Mastercard…
  pointsPerDollar Int // x100 (2,2 pts/US$ = 220)
  dollarRateCents Int      @default(550) // cotação usada no cálculo (R$ por US$)
  closingDay      Int // dia do fechamento
  dueDay          Int // dia do vencimento
  annualFeeCents  Int      @default(0)
  feeWaiverCents  Int? // gasto mensal que isenta a parcela da anuidade (ex.: R$ 8.000)
  balanceEntryId  String?  @unique // lançamento "Saldo inicial" com os pontos já acumulados no cartão
  balanceEntry    Entry?   @relation("CardBalance", fields: [balanceEntryId], references: [id], onDelete: SetNull)
  active          Boolean  @default(true)
  bank            String? // banco emissor (Nubank, Itaú…)
  brandTier       String? // categoria da bandeira (Visa Infinite, Mastercard Black…)
  last4           String? // só os 4 últimos dígitos; nunca o número completo nem o CVV
  printedName     String? // nome impresso no cartão
  modality        String? // CREDIT | DEBIT | MULTIPLE | PREPAID | CORPORATE
  cardType        String? // HOLDER | ADDITIONAL
  status          String   @default("ACTIVE") // ACTIVE | BLOCKED | CANCELED | EXPIRED
  expMonth        Int?
  expYear         Int?
  limitCents      Int?
  annualFeeMonth  Int? // mês em que a anuidade é cobrada (1-12)
  color           String? // cor do cartão na vitrine (#rrggbb)
  benefits        String[] @default([])
  benefitsUrl     String?
  tags            String[] @default([])
  notes           String?
  createdAt       DateTime @default(now())

  invoices        CardInvoice[]
  entryCosts      EntryCost[]
  reminders       CardReminder[]
  attachments     CardAttachment[]
  activity        CardActivity[]
  finTransactions FinTransaction[]
  billPayments    CardBillPayment[]
  bills           CardBill[]
  milesDeals      MilesDeal[]

  @@index([userId])
}

model CardReminder {
  id          String     @id @default(cuid())
  cardId      String
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind        String // DUE | CLOSING | ANNUAL_FEE | EXPIRY | BENEFIT | CUSTOM
  title       String
  date        DateTime // próxima ocorrência (dia)
  recurrence  String     @default("NONE") // NONE | MONTHLY | YEARLY
  advanceDays Int        @default(0)
  whatsapp    Boolean    @default(false)
  note        String?
  createdAt   DateTime   @default(now())

  @@index([cardId])
}

model CardAttachment {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime   @default(now())

  @@index([cardId])
}

model CardActivity {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind      String     @default("COMMENT") // COMMENT | ACTIVITY
  text      String
  createdAt DateTime   @default(now())

  @@index([cardId])
}

model CardInvoice {
  id             String        @id @default(cuid())
  cardId         String
  card           CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  closingDate    DateTime
  dueDate        DateTime
  amountCents    Int
  expectedPoints Int
  feeCents       Int           @default(0) // parcela da anuidade nesta fatura (vira custo dos pontos)
  pointsIncluded Boolean       @default(false) // pontos já contados no saldo acumulado do cartão: fechar não lança de novo
  status         InvoiceStatus @default(OPEN)
  entryId        String?       @unique // lançamento "a receber" criado ao fechar a fatura
  entry          Entry?        @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([cardId, dueDate])
}

model Guide {
  id        String     @id @default(cuid())
  slug      String     @unique
  kind      GuideKind
  title     String
  summary   String
  body      String // texto simples; linhas em branco separam parágrafos, "## " vira subtítulo
  level     GuideLevel @default(BEGINNER)
  minutes   Int        @default(5)
  tags      String[]
  videoUrl  String?
  order     Int        @default(0)
  published Boolean    @default(true)
  updatedAt DateTime   @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime @default(now())
  published   Boolean  @default(true)

  @@index([publishedAt])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// Lançamento recorrente (ex.: assinatura de clube): gera um crédito a cada vencimento
model Recurrence {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         EntryType           @default(CLUB)
  description  String
  points       Int
  costCents    Int                 @default(0)
  frequency    RecurrenceFrequency @default(MONTHLY)
  interval     Int                 @default(1) // a cada N períodos
  dayOfMonth   Int? // mensal: dia fixo (vazio = dia da primeira data)
  endDate      DateTime?
  skipWeekends Boolean             @default(false)
  nextDate     DateTime
  notify       Boolean             @default(true)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())

  @@index([userId, nextDate])
}

// Login e senha da conta no programa, criptografados (AES-256-GCM com CREDENTIALS_KEY)
model AccountCredential {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  loginEnc  String
  secretEnc String
  notesEnc  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Itens de custo de um lançamento (Custos: tipo | valor | cartão).
// Em créditos, a soma vira o custo dos pontos; em resgates, é o gasto em dinheiro do resgate.
model EntryCost {
  id          String      @id @default(cuid())
  entryId     String
  entry       Entry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  type        String // PONTOS, IOF, OUTROS, FRETE, MARKUP, MENSALIDADE, ANUIDADE, TAXA_EMBARQUE, COMPLETAR_PONTOS
  amountCents Int
  cardId      String?
  card        CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([entryId])
}

// Imagem do programa, separada para não vir junto em toda consulta de Program
model ProgramLogo {
  programId String  @id
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
}

// Simulação salva ("Recentes" dos simuladores): tipo, título e os valores informados
model Simulation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // bonificada, store-comparison, pontos, transfer, flight, hotel, sale, supplier-ranking
  title     String
  input     Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Anexo do titular (contratos, comprovantes): PNG, JPEG, WEBP, HEIC ou PDF, até 10 MB, no máximo 10
model HolderAttachment {
  id        String   @id @default(cuid())
  holderId  String
  holder    Holder   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([holderId])
}

// Página do titular: link de uso único enviado ao e-mail autorizado, trocado por uma sessão só de leitura
model HolderAccess {
  id               String    @id @default(cuid())
  holderId         String
  holder           Holder    @relation(fields: [holderId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  sessionHash      String?   @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([holderId, createdAt])
}

// Assinatura paga no Mercado Pago (preapproval). O plano do usuário só muda pelo webhook,
// depois de consultar a assinatura na API do Mercado Pago com o token do servidor.
model Subscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("MERCADOPAGO")
  externalId  String?  @unique // id do preapproval
  plan        Plan
  interval    String // MENSAL | ANUAL
  amountCents Int
  status      String   @default("PENDING") // PENDING | AUTHORIZED | PAUSED | CANCELLED
  checkoutUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

// CRM de pedidos de emissão: funis (Funil Comercial, Pós-Venda...) com colunas editáveis, captação pela página pública.
model OrderPipeline {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  stages    OrderPipelineStage[]

  @@index([userId, position])
}

model OrderPipelineStage {
  id         String        @id @default(cuid())
  pipelineId String
  pipeline   OrderPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  color      String        @default("#60a5fa")
  position   Int           @default(0)
  createdAt  DateTime      @default(now())
  orders     TravelOrder[]

  @@index([pipelineId, position])
}

model TravelOrder {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  number        Int // sequencial por usuário (Pedido 1, 2, ...)
  customerId    String?
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  customerEmail String?
  stageId       String // coluna do funil
  stage         OrderPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  position      Int                @default(0) // ordem dentro da coluna
  tripType      String             @default("ONE_WAY") // ONE_WAY | ROUND_TRIP | MULTI
  cabin         String             @default("ECONOMY") // ECONOMY | PREMIUM | BUSINESS | FIRST
  segments      Json // [{ origin, destination, date }]
  adults        Int                @default(1)
  children      Int                @default(0)
  infants       Int                @default(0)
  flexibleDates Boolean            @default(false)
  checkedBag    Boolean            @default(false)
  priority      String             @default("MEDIUM") // LOW | MEDIUM | HIGH
  budgetCents   Int?
  notes         String?
  source        String             @default("MANUAL") // MANUAL | PUBLIC
  archivedAt    DateTime?
  archiveReason String?
  shareToken    String?            @unique // link das páginas "Cotação" e "Reserva confirmada" para o cliente
  locator       String? // localizador da reserva emitida
  clientNotes   String? // recado para o cliente na página da reserva
  proposal      Json? // cotação para o cliente: voos, bagagem, valores, condições (domain/proposal.ts)
  reservation   Json? // reserva emitida: programa, companhia, sobrenome, passageiros
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  attachments OrderAttachment[]
  events      OrderEvent[]
  quotes      FlightQuote[]
  signatures  ContractSignature[]
  accesses    OrderAccess[]

  @@unique([userId, number])
  @@index([userId, stageId])
}

model OrderAttachment {
  id              String      @id @default(cuid())
  orderId         String
  order           TravelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name            String
  mime            String
  size            Int
  data            Bytes
  visibleToClient Boolean     @default(false)
  createdAt       DateTime    @default(now())
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     TravelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // created | stage | archived | unarchived | quote | note
  fromStage String?
  toStage   String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// Cotação anotada pelo usuário (comparador do buscador). Base do futuro tradutor de milhas.
model FlightQuote {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String?
  order         TravelOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  program       String // chave do programa do buscador (smiles, latam, azul, ...)
  origin        String
  destination   String
  departDate    DateTime     @db.Date
  returnDate    DateTime?    @db.Date
  cabin         String       @default("ECONOMY")
  adults        Int          @default(1)
  miles         Int?
  taxesCents    Int?
  cashCents     Int?
  costCpmCents  Int? // custo do milheiro (ex.: preço do balcão); vazio = CPM médio do estoque
  issueFeeCents Int? // taxa de emissão cobrada do cliente (entra no valor em dinheiro e é lucro)
  issueFeeBps   Int? // taxa de emissão em % do total da passagem (1% = 100); vazio = valor fixo
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([userId, origin, destination])
}

model FlightSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  params    Json // { origin, destination, departDate, returnDate, adults, children, infants, cabin }
  programs  String[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Interessado em gestão de milhas, vindo da Central de Atendimento (página pública).
model MilesLead {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  message     String?
  programs    String[] @default([])
  incomeRange String?
  status      String   @default("NEW") // NEW | CONTACTED | CLIENT | DISCARDED
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// "Assinatura de contrato" da página pública: o cliente lê os termos de gestão de milhas e aceita.
// Guarda uma cópia dos termos aceitos para não depender de edições posteriores.
model ContractSignature {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     TravelOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  cpf       String?
  birthDate String?
  address   String?
  terms     String
  ipHash    String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

// Acesso do cliente às páginas do pedido (cotação, reserva, contrato) depois de confirmar os
// 4 últimos dígitos do telefone. O cookie guarda um token aleatório; aqui fica só o hash.
model OrderAccess {
  id          String      @id @default(cuid())
  orderId     String
  order       TravelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sessionHash String      @unique
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

// Beneficiário (CPF) que recebeu uma emissão com os pontos da conta. Vem das vendas (clientes do
// item) ou é informado à mão; conta para o limite de beneficiários do programa.
model AccountBeneficiary {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name      String
  document  String? // CPF só com dígitos
  usedAt    DateTime
  createdAt DateTime @default(now())

  @@index([accountId, usedAt])
}

// Parcerias de transferência entre programas (calculadora de rotas). Paridade origem:destino, ex.: 1:1, 3:1, 1:5,5.
model TransferPartner {
  id            String   @id @default(cuid())
  fromProgramId String
  fromProgram   Program  @relation("PartnerFrom", fields: [fromProgramId], references: [id], onDelete: Cascade)
  toProgramId   String
  toProgram     Program  @relation("PartnerTo", fields: [toProgramId], references: [id], onDelete: Cascade)
  fromUnits     Float    @default(1)
  toUnits       Float    @default(1)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([fromProgramId, toProgramId])
}

// Catálogo de clubes (simulador de assinatura), mantido pelo admin.
model ClubPlan {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String
  modality     String   @default("Mensal")
  miles        Int
  monthlyCents Int
  signupBonus  Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([programId, name, modality])
}

// CRM Milhas: negociação de venda de milhas (para agência, balcão ou cliente final). Ao chegar em
// "Pago" vira uma venda em Vendas, com baixa dos pontos da conta escolhida.
enum MilesDealStage {
  NEW // Novo interesse
  NEGOTIATION // Negociação
  AWAITING // Aguardando dados / emissão
  ISSUED // Emitido
  PAID // Pago
}

model MilesDeal {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          Int // sequencial por usuário
  buyerType       String            @default("FINAL") // AGENCY | BALCAO | FINAL
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  stage           MilesDealStage    @default(NEW)
  position        Int               @default(0) // ordem dentro da coluna
  accountId       String? // conta de onde saem as milhas
  account         Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  points          Int?
  saleCpmCents    Int? // preço do milheiro na venda
  profitCents     Int? // lucro informado à mão; vazio = estimado pelo CPM da conta
  passengers      Int?
  notes           String?
  taxesCents      Int? // taxas da emissão, pagas por mim e cobradas do comprador
  taxesCardId     String? // cartão em que as taxas foram pagas: vão para a fatura dele (na venda, no custo "taxa de embarque")
  taxesCard       CreditCard?       @relation(fields: [taxesCardId], references: [id], onDelete: SetNull)
  orderLink       String? // link do pedido no programa (ex.: passageiros da LATAM)
  shareToken      String?           @unique // link da página do comprador
  passengersData  Json? // [{ name, cpf, birthDate, email, phone }] preenchido pelo comprador
  passengersAt    DateTime? // quando o comprador enviou os passageiros
  locator         String? // localizador da emissão (aparece na página do comprador)
  faceCheckUrl    String? // verificação antes da emissão: link da validação facial (formato novo)
  faceCheckStatus String? // PENDING | DONE | NOT_NEEDED; o bilhete só entra com DONE ou NOT_NEEDED
  faceCheckAt     DateTime?
  saleId          String?           @unique // venda criada ao chegar em "Pago"
  sale            Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  ticket          MilesDealTicket? // bilhete anexado: só com ele a negociação está "Emitida"
  receipt         MilesDealReceipt? // comprovante de pagamento: só com ele a negociação vai para "Pago" (vira venda)
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, number])
  @@index([userId, stage])
}

/// Comprovante de pagamento da negociação do CRM Milhas (vai junto para os anexos da venda)
model MilesDealReceipt {
  dealId    String    @id
  deal      MilesDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
}

/// Bilhete (passagem) da negociação do CRM Milhas; os bytes ficam fora da tabela principal
model MilesDealTicket {
  dealId    String    @id
  deal      MilesDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
}

// ViajeFácil (Smiles): a reserva é feita agora e paga em milhas até a data limite. O radar mostra o que vence.
model ViajeFacil {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName   String
  deadline       DateTime // data limite para quitar com milhas
  miles          Int
  roundTrip      Boolean   @default(false)
  origin         String?
  destination    String?
  cabin          String? // ECONOMY | PREMIUM | BUSINESS | FIRST
  passengers     String[]  @default([])
  milesInAccount Boolean   @default(false) // o cliente já tem o saldo para quitar
  notes          String?
  paidAt         DateTime? // quitada com milhas
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, deadline])
}

// Financeiro: contas (banco, caixa) e lançamentos de receita, despesa e transferência entre contas.
model FinAccount {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         String            @default("BANK") // BANK | CASH | WALLET | OTHER
  initialCents Int               @default(0) // saldo no dia em que a conta foi cadastrada
  color        String            @default("#60a5fa")
  archived     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  outgoing     FinTransaction[]  @relation("FinFrom")
  incoming     FinTransaction[]  @relation("FinTo")
  billPayments CardBillPayment[]
  sales        Sale[] // vendas recebidas nesta conta

  @@index([userId])
}

model FinTransaction {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // INCOME | EXPENSE | TRANSFER
  accountId   String
  account     FinAccount  @relation("FinFrom", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId String? // transferência: conta de destino
  toAccount   FinAccount? @relation("FinTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  category    String? // "Grupo › Item" (domain/finance.ts)
  amountCents Int
  description String?
  counterpart String? // fornecedor ou cliente
  competence  DateTime // mês a que pertence (regime de competência)
  dueDate     DateTime // vencimento / data prevista do pagamento (regime de caixa)
  paidAt      DateTime? // pago ou recebido; vazio = pendente (não mexe no saldo)
  repeatGroup String? // lançamentos criados juntos pela repetição mensal
  cardId      String? // despesa no cartão: dueDate é a data da compra; vence na fatura e fica paga quando a fatura é paga
  card        CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([userId, dueDate])
  @@index([userId, competence])
  @@index([cardId])
}

/// Pagamento de uma fatura do cartão (pode haver vários: pagamento parcial). A fatura em si é calculada: a soma do
/// que foi comprado no cartão (custos do Extrato, custos das vendas e despesas do Financeiro) que vence naquele dia.
model CardBillPayment {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId      String
  card        CreditCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  dueDate     DateTime // vencimento calculado da fatura (a chave dela)
  paidAt      DateTime // quando foi pago
  amountCents Int // quanto foi pago
  accountId   String? // conta do Financeiro de onde saiu o dinheiro
  account     FinAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([cardId, dueDate])
  @@index([userId])
}

/// Ajustes de uma fatura: o valor real que veio no banco (a diferença para as compras lançadas vira "outros gastos
/// no cartão") e o vencimento, quando o banco muda o dia só naquele mês. dueDate é o vencimento calculado (a chave).
model CardBill {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId      String
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  realCents   Int? // valor real da fatura; vazio = a soma das compras
  dueOverride DateTime? // vencimento desta fatura, quando não é o dia normal do cartão
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([cardId, dueDate])
  @@index([userId])
}

// Equipe: pessoas da operação (responsáveis por tarefas e metas). O login de membros vem depois.
model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String? // cargo
  email     String?
  phone     String?
  color     String   @default("#60a5fa")
  active    Boolean  @default(true)
  issuer    Boolean  @default(false) // emite passagens
  createdAt DateTime @default(now())
  goals     Goal[]

  @@index([userId])
}

// Tarefas em quadro (A fazer, Fazendo, Feito)
// Tarefas em quadros (colunas por pessoa ou por situação), com checklist, anexos, comentários e recorrência
model TaskBoard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  columns     Json     @default("[]") // [{ id, name }]: a primeira é "pendente", a última "concluída"
  restricted  Boolean  @default(false) // só o dono e os membros escolhidos
  memberIds   String[] @default([])
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@index([userId])
}

model Task {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId     String?
  board       TaskBoard?       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  description String?
  columnId    String? // coluna do quadro; vazia = a coluna que corresponde à situação
  status      String           @default("TODO") // TODO (Pendente) | DOING (Em progresso) | DONE (Concluída)
  priority    String           @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  memberIds   String[]         @default([]) // membros (TeamMember); vazio = o dono da conta
  dueDate     DateTime?
  dueTime     String? // HH:MM
  checklist   Json             @default("[]") // [{ text, done }]
  recurrence  String           @default("NONE") // NONE | DAILY | WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | SEMIANNUAL | YEARLY
  position    Int              @default(0)
  doneAt      DateTime?
  createdAt   DateTime         @default(now())
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([userId, status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String   @default("COMMENT") // COMMENT | ACTIVITY
  text      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Metas: objetivo do período com resultados-chave (alguns medidos sozinhos pelas vendas)
model Goal {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  period     String // MONTH | QUARTER | YEAR
  start      DateTime // primeiro dia do período
  memberId   String? // responsável (vazio = empresa)
  member     TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  keyResults KeyResult[]

  @@index([userId, start])
}

model KeyResult {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  metric    String   @default("MANUAL") // MANUAL | REVENUE | PROFIT | SALES | MILES | CUSTOMERS
  target    Int // centavos (REVENUE/PROFIT) ou quantidade
  current   Int      @default(0) // só para MANUAL
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Processos: passo a passo da operação, reaproveitável (vira tarefas quando usado)
model Process {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  steps       Json // [{ title, detail? }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Passageiros: quem viaja (CPF, nascimento), ligado ao cliente que comprou
model Passenger {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  cpf        String? // só dígitos
  birthDate  DateTime?
  email      String?
  phone      String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime  @default(now())

  @@unique([userId, cpf])
  @@index([userId, name])
}

// Interesses de viagem dos clientes: destino, quando, prioridade e o andamento
model TravelInterest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  origin       String?
  destination  String
  month        String? // AAAA-MM (vazio = qualquer época)
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status       String    @default("NEW") // NEW | SEARCHING | OFFER_SENT | BOOKED | LOST
  programs     String[]  @default([])
  notes        String?
  offerSentAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
}

// Parceiros externos: regra de comissão aplicada nas vendas em que aparecem
model Partner {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mode      String   @default("PROFIT_PCT") // PROFIT_PCT (% do lucro) | SALE_PCT (% da venda) | FIXED (R$ por venda)
  value     Int // % × 100 (ex.: 10% = 1000) ou centavos no valor fixo
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]

  @@index([userId])
}
